APP_NAME="Semarang Food Explorer"
APP_ENV=production
# WAJIB false di production - kalau true, setiap error menampilkan stack
# trace + isi query DB + path server ke pengunjung. Ini penyebab kebocoran
# data paling umum di deploy Laravel yang buru-buru.
APP_DEBUG=false
# Generate sendiri di server dengan: php artisan key:generate
# JANGAN pernah pakai APP_KEY yang sama dengan .env development/lokal.
APP_KEY=
# Ganti dengan domain asli kamu, HARUS https:// (bukan http://)
APP_URL=https://domainkamu.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Jangan pakai LOG_LEVEL=debug di production - terlalu berisik & bisa
# menyimpan data sensitif di storage/logs/laravel.log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL - standar di hosting cPanel seperti Rumahweb) ────
# Buat database + user lewat menu "MySQL Databases" di cPanel Rumahweb,
# lalu isi kredensial yang diberikan di sana persis di sini.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=namacpanel_namadb
DB_USERNAME=namacpanel_namauser
DB_PASSWORD=

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true begitu domain sudah HTTPS - mencegah cookie sesi terkirim
# lewat koneksi HTTP biasa (rawan disadap di jaringan publik).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Services ─────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = job (notifikasi, dsb) langsung diproses saat itu juga, tanpa
# perlu worker/cron terpisah. Paling aman untuk shared hosting yang
# biasanya tidak mendukung proses background permanen.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ── Mail ─────────────────────────────────────────────────────
# log = email tidak benar-benar terkirim, cuma dicatat ke log. Aplikasi
# ini tidak punya fitur yang bergantung pada email asli (tidak ada lupa
# password lewat email), jadi aman dibiarkan log kalau belum mau setup
# SMTP. Kalau mau email asli aktif, isi SMTP dari cPanel > Email Accounts.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@domainkamu.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Search ─────────────────────────────────────────────────
SCOUT_DRIVER=database

# ── Sentry (opsional, untuk error monitoring) ────────────────
SENTRY_LARAVEL_DSN=

# ── Media ─────────────────────────────────────────────────────
MEDIA_DISK=public

# ── Telegram Bot (opsional, notifikasi pembayaran) ────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Midtrans Payment Gateway ─────────────────────────────────
# Biarkan false sampai kamu benar-benar punya akun Midtrans production
# terverifikasi bisnis. Selama false, semua transaksi tetap sandbox -
# aman, tidak ada uang asli yang bisa terpotong.
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="SB-Mid-client-..."
MIDTRANS_IS_PRODUCTION=false
